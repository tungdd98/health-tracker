{
  "name": "health-tracker-web",
  "root": "apps/health-tracker-web",
  "sourceRoot": "apps/health-tracker-web/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite build --config apps/health-tracker-web/vite.config.ts"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite --host 127.0.0.1 --config apps/health-tracker-web/vite.config.ts"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint apps/health-tracker-web/src apps/health-tracker-web/vite.config.ts --max-warnings=0"
      }
    }
  },
  "tags": []
}
