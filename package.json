    "@mui/material": "^7.3.2",
    "@supabase/supabase-js": "^2.56.1",
    "@tanstack/react-query": "^5.87.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.62.0",
    "react-router-dom": "^7.8.2",
    "zustand": "^5.0.8",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@eslint/js": "^9.35.0",
    "@nx/js": "^22.0.0",
    "@nx/react": "^22.0.0",
    "@nx/vite": "^22.0.0",
    "@types/node": "^24.3.1",
